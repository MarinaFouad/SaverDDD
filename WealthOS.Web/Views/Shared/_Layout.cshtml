<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Saver </title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container topbar-inner">
            <a class="brand" asp-controller="Dashboard" asp-action="Index">Saver</a>
            <nav class="nav">
                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a asp-controller="Income" asp-action="Index">Income</a>
                <a asp-controller="Expense" asp-action="Index">Expenses</a>
                <a asp-controller="Saving" asp-action="Index">Savings</a>
                <a asp-controller="Goal" asp-action="Index">Goal</a>
                <a asp-controller="WeeklyTask" asp-action="Index">Weekly Tasks</a>
            </nav>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">Saver &middot; </div>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
