@model ExpenseFormViewModel
@{ ViewData["Title"] = "Expenses"; }

<h1 class="page-title">Expenses</h1>
<p class="page-subtitle">Log every expense &mdash; this feeds your surplus, savings rate, and weekly tasks.</p>

<div class="grid grid-2">
    <div class="card">
        <p class="stat-label">Add expense</p>
        <form asp-controller="Expense" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="form-row">
                <div class="field">
                    <label asp-for="Amount">Amount</label>
                    <input asp-for="Amount" type="number" step="0.01" />
                    <span asp-validation-for="Amount" class="validation-message"></span>
                </div>
                <div class="field">
                    <label asp-for="Category">Category</label>
                    <select asp-for="Category" asp-items="Html.GetEnumSelectList<ExpenseCategory>()"></select>
                </div>
            </div>
            <div class="form-row">
                <div class="field">
                    <label asp-for="Date">Date</label>
                    <input asp-for="Date" type="date" />
                </div>
                <div class="field">
                    <label asp-for="Note">Note (optional)</label>
                    <input asp-for="Note" type="text" />
                </div>
            </div>
            <button type="submit" class="btn">Add expense</button>
        </form>
    </div>

    <div class="card">
        <p class="stat-label">History</p>
        @if (Model.Existing.Count == 0)
        {
            <p class="empty-state">No expenses logged yet.</p>
        }
        else
        {
            <table class="ledger">
                <thead><tr><th>Date</th><th>Category</th><th>Note</th><th style="text-align:right;">Amount</th></tr></thead>
                <tbody>
                @foreach (var e in Model.Existing)
                {
                    <tr>
                        <td>@e.Date.ToString("MMM d")</td>
                        <td>@e.Category</td>
                        <td>@e.Note</td>
                        <td class="amount expense">-@e.Amount.ToString("N0")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
