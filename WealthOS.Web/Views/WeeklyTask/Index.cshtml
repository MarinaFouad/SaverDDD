@model List<WeeklyTaskDto>
@{ ViewData["Title"] = "Weekly Tasks"; }

<div style="display:flex;align-items:center;justify-content:space-between;">
    <div>
        <h1 class="page-title">This week's tasks</h1>
        <p class="page-subtitle">Generated from your surplus, savings rate, and goal &mdash; add your own, edit, or check them off.</p>
    </div>
    <a asp-controller="WeeklyTask" asp-action="Create" class="btn">+ Add task</a>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <p class="empty-state">No tasks yet &mdash; visit the Dashboard to generate this week's tasks, or add one yourself.</p>
    }
    else
    {
        <ul class="task-list">
            @foreach (var t in Model)
            {
                <li class="task-item @(t.IsCompleted ? "completed" : "")">
                    <span class="badge @(t.Type == TaskType.IncreaseIncome ? "badge-gold" : t.Type == TaskType.ReduceExpenses ? "badge-brick" : "badge-emerald")">
                        @(t.Type == TaskType.IncreaseIncome ? "Income" : t.Type == TaskType.ReduceExpenses ? "Expenses" : "Savings")
                    </span>
                    <div style="flex:1;">
                        <p class="task-title">
                            @t.Title
                            @if (t.Source == TaskSource.Ai)
                            {
                                <span class="badge badge-gold" style="margin-left:6px;font-weight:600;">AI coach</span>
                            }
                            else if (t.Source == TaskSource.Manual)
                            {
                                <span class="badge badge-emerald" style="margin-left:6px;font-weight:600;">Manual</span>
                            }
                        </p>
                        <p class="task-desc">@t.Description</p>
                    </div>
                    <div style="display:flex;gap:8px;flex-shrink:0;">
                        @if (t.IsCompleted)
                        {
                            <form asp-controller="WeeklyTask" asp-action="Uncomplete" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="btn btn-secondary">Undo</button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="WeeklyTask" asp-action="Complete" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="btn btn-secondary">Mark done</button>
                            </form>
                        }
                        <a asp-controller="WeeklyTask" asp-action="Edit" asp-route-id="@t.Id" class="btn btn-secondary">Edit</a>
                        <form asp-controller="WeeklyTask" asp-action="Delete" method="post" onsubmit="return confirm('Delete this task?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@t.Id" />
                            <button type="submit" class="btn btn-secondary">Delete</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    }
</div>
