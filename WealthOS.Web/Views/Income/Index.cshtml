@model IncomeFormViewModel
@{ ViewData["Title"] = "Income"; }

<h1 class="page-title">Income</h1>
<p class="page-subtitle">Log every income entry &mdash; salary, freelance, business, investment.</p>

<div class="grid grid-2">
    <div class="card">
        <p class="stat-label">Add income</p>
        <form asp-controller="Income" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="form-row">
                <div class="field">
                    <label asp-for="Amount">Amount</label>
                    <input asp-for="Amount" type="number" step="0.01" />
                    <span asp-validation-for="Amount" class="validation-message"></span>
                </div>
                <div class="field">
                    <label asp-for="Source">Source</label>
                    <select asp-for="Source" asp-items="Html.GetEnumSelectList<IncomeSource>()"></select>
                </div>
            </div>
            <div class="form-row">
                <div class="field">
                    <label asp-for="Date">Date</label>
                    <input asp-for="Date" type="date" />
                </div>
                <div class="field">
                    <label asp-for="Note">Note (optional)</label>
                    <input asp-for="Note" type="text" />
                </div>
            </div>
            <button type="submit" class="btn">Add income</button>
        </form>
    </div>

    <div class="card">
        <p class="stat-label">History</p>
        @if (Model.Existing.Count == 0)
        {
            <p class="empty-state">No income logged yet.</p>
        }
        else
        {
            <table class="ledger">
                <thead><tr><th>Date</th><th>Source</th><th>Note</th><th style="text-align:right;">Amount</th></tr></thead>
                <tbody>
                @foreach (var i in Model.Existing)
                {
                    <tr>
                        <td>@i.Date.ToString("MMM d")</td>
                        <td>@i.Source</td>
                        <td>@i.Note</td>
                        <td class="amount income">+@i.Amount.ToString("N0")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
