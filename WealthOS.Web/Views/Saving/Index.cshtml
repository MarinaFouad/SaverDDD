@model SavingFormViewModel
@{ ViewData["Title"] = "Savings"; }

<h1 class="page-title">Savings</h1>
<p class="page-subtitle">Log money you've actually moved into savings or investments &mdash; this is what your net worth is built from.</p>

<div class="grid grid-2">
    <div class="card">
        <p class="stat-label">Add saving</p>
        <form asp-controller="Saving" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="form-row">
                <div class="field">
                    <label asp-for="Amount">Amount</label>
                    <input asp-for="Amount" type="number" step="0.01" />
                    <span asp-validation-for="Amount" class="validation-message"></span>
                </div>
                <div class="field">
                    <label asp-for="Date">Date</label>
                    <input asp-for="Date" type="date" />
                </div>
            </div>
            <div class="field">
                <label asp-for="Note">Note (optional)</label>
                <input asp-for="Note" type="text" />
            </div>
            <button type="submit" class="btn">Add saving</button>
        </form>
    </div>

    <div class="card">
        <p class="stat-label">History</p>
        @if (Model.Existing.Count == 0)
        {
            <p class="empty-state">No savings logged yet.</p>
        }
        else
        {
            <table class="ledger">
                <thead><tr><th>Date</th><th>Note</th><th style="text-align:right;">Amount</th></tr></thead>
                <tbody>
                @foreach (var s in Model.Existing)
                {
                    <tr>
                        <td>@s.Date.ToString("MMM d")</td>
                        <td>@s.Note</td>
                        <td class="amount income">+@s.Amount.ToString("N0")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
